# App & Auth Configuration
JWT_SECRET="resolvely-super-secure-jwt-secret-key-2026-production"
JWT_EXPIRES_IN="7d"
APP_URL="http://localhost:8080"

# AI Integration (Google Gemini API - Add your key from https://aistudio.google.com)
GOOGLE_GENERATIVE_AI_API_KEY="your-google-gemini-api-key"

# Database (Prisma MySQL - Optional / Local Mock Fallback enabled by default)
DATABASE_URL="mysql://root:password@localhost:3306/resolvely"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Notifications / SMTP (Optional - Nodemailer dev mode logs to console)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Resolvely Support <noreply@resolvely.app>"
