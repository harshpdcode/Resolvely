# Database (Prisma with MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/resolvely"

# Authentication (JWT)
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"
JWT_EXPIRES_IN="7d"

# App URL
APP_URL="http://localhost:3000"

# AI Integration (Google Gemini API)
GOOGLE_GENERATIVE_AI_API_KEY="your-google-gemini-api-key"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Notifications / SMTP (Optional - Nodemailer)
NODEMAILER_HOST="smtp.gmail.com"
NODEMAILER_PORT="587"
NODEMAILER_USER="your-email@gmail.com"
NODEMAILER_PASS="your-gmail-app-password"
NODEMAILER_FROM="Resolvely Support <noreply@resolvely.com>"
